{
  "name": "spiko-api-toolkit",
  "version": "0.2.0",
  "private": true,
  "description": "Effect-native clients, CLI, and MCP server for Spiko's APIs.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm check:code && pnpm generate:check",
    "check:code": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "changeset-publish": "pnpm build && changeset publish",
    "changeset-version": "changeset version",
    "dev:cli": "pnpm --filter spiko-cli dev",
    "dev:mcp": "pnpm --filter spiko-mcp dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate:check": "pnpm generate:clients && git diff --exit-code -- openapi packages/public-api-client/src/generated.ts packages/investor-api-client/src/generated.ts packages/distributor-api-client/src/generated.ts apps/cli/src/generated/public.ts apps/cli/src/generated/investor.ts apps/cli/src/generated/distributor.ts",
    "generate:clients": "node --experimental-strip-types tools/generate-clients.ts",
    "lint": "oxlint --type-aware --deny-warnings .",
    "postinstall": "effect-tsgo patch --oxlint",
    "specs:update": "node --experimental-strip-types tools/generate-clients.ts --fetch",
    "test": "pnpm --filter './packages/**' -r build && pnpm -r --if-present test",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/openapi-generator": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/tsgo": "0.53.2",
    "@types/node": "24.19.2",
    "effect": "4.0.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "rolldown": "1.2.14",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.14.0"
}
